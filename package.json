{
	"name": "neomail",
	"description": "Self-hosted email for your domains, with web push and scoped MCP access.",
	"private": true,
	"license": "Apache-2.0",
	"x-upstream-modification": "Modified for NeoMail; see NOTICE and MODIFICATIONS.md.",
	"type": "module",
	"engines": {
		"node": ">=24.4.0"
	},
	"scripts": {
		"build": "react-router build && esbuild server/start.ts --bundle --platform=node --packages=external --format=esm --outfile=build/start.mjs",
		"start": "node build/start.mjs",
		"push:keys": "bun scripts/generate-push-keys.mjs",
		"dev": "node --import tsx server/start.ts --dev",
		"build:cloudflare": "react-router build",
		"dev:cloudflare": "bun run build:cloudflare && wrangler dev --config wrangler.jsonc",
		"deploy": "bun run build:cloudflare && wrangler deploy --config wrangler.jsonc",
		"test": "node --import tsx --test tests/*.test.mjs",
		"test:cloudflare": "bun run build:cloudflare && node --test tests/cloudflare.worker.mjs",
		"typecheck": "react-router typegen && tsc -b"
	},
	"dependencies": {
		"@base-ui/react": "1.3.0",
		"@block65/webcrypto-web-push": "2.0.0",
		"@cloudflare/kumo": "^1.13.0",
		"@hono/node-server": "^2.1.11",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.99.0",
		"@tiptap/extension-color": "3.20.2",
		"@tiptap/extension-highlight": "3.20.2",
		"@tiptap/extension-image": "3.20.2",
		"@tiptap/extension-link": "3.20.2",
		"@tiptap/extension-text-align": "3.20.2",
		"@tiptap/extension-text-style": "3.20.2",
		"@tiptap/extension-underline": "3.20.2",
		"@tiptap/react": "3.20.2",
		"@tiptap/starter-kit": "3.20.2",
		"dompurify": "^3.3.3",
		"drizzle-orm": "^0.45.1",
		"express": "^5.3.0",
		"hono": "^4.7.11",
		"isbot": "^5.1.27",
		"nodemailer": "^10.6.1",
		"postal-mime": "^2.6.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.5.3",
		"smtp-server": "^3.21.7",
		"zod": "^3.25.76",
		"zustand": "^5.0.12"
	},
	"overrides": {
		"@cloudflare/kumo": {
			"zod": "$zod"
		},
		"@tiptap/core": "3.20.2",
		"@tiptap/pm": "3.20.2",
		"@tiptap/extensions": "3.20.2",
		"@tiptap/extension-blockquote": "3.20.2",
		"@tiptap/extension-bold": "3.20.2",
		"@tiptap/extension-bubble-menu": "3.20.2",
		"@tiptap/extension-bullet-list": "3.20.2",
		"@tiptap/extension-code": "3.20.2",
		"@tiptap/extension-code-block": "3.20.2",
		"@tiptap/extension-document": "3.20.2",
		"@tiptap/extension-dropcursor": "3.20.2",
		"@tiptap/extension-floating-menu": "3.20.2",
		"@tiptap/extension-gapcursor": "3.20.2",
		"@tiptap/extension-hard-break": "3.20.2",
		"@tiptap/extension-heading": "3.20.2",
		"@tiptap/extension-horizontal-rule": "3.20.2",
		"@tiptap/extension-italic": "3.20.2",
		"@tiptap/extension-list": "3.20.2",
		"@tiptap/extension-list-item": "3.20.2",
		"@tiptap/extension-list-keymap": "3.20.2",
		"@tiptap/extension-ordered-list": "3.20.2",
		"@tiptap/extension-paragraph": "3.20.2",
		"@tiptap/extension-strike": "3.20.2",
		"@tiptap/extension-text": "3.20.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261125.1",
		"@react-router/dev": "^7.5.3",
		"@tailwindcss/vite": "^4.1.4",
		"@types/dompurify": "^3.0.5",
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/nodemailer": "^8.0.2",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@types/smtp-server": "^3.5.13",
		"esbuild": "^0.28.2",
		"tailwindcss": "^4.1.4",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"vite": "^6.3.3",
		"vite-tsconfig-paths": "^5.1.4",
		"wrangler": "4.168.0"
	}
}

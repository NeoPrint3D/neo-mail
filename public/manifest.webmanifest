{
  "id": "/",
  "name": "NeoMail",
  "short_name": "NeoMail",
  "lang": "en",
  "description": "Self-hosted email for your domains.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#131820",
  "theme_color": "#131820",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "/icons/inbox-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/inbox-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/inbox-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Open inbox", "short_name": "Inbox", "url": "/", "icons": [{ "src": "/icons/inbox-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Manage mailboxes", "short_name": "Mailboxes", "url": "/mailboxes", "icons": [{ "src": "/icons/inbox-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}

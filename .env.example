# HTTP: use a reverse proxy with HTTPS on public installs.
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# APP_URL=https://mail.example.com
# TRUST_PROXY=1
# Optional. If unset, a random first-run code is printed to the server log.
# SETUP_CODE=use-a-long-random-secret-at-least-20-characters

# Outbound: your SMTP relay (SMTP + STARTTLS or implicit TLS).
# SMTP_URL=smtps://username:password@smtp.example.net:465
# Inbound: 0 disables the listener. Use port 25 or map public 25 to an unprivileged port.
SMTP_INBOUND_PORT=0
# SMTP_INBOUND_HOST=0.0.0.0
# MAIL_HOSTNAME=mx.example.com
# SMTP_TLS_KEY=/run/secrets/smtp.key
# SMTP_TLS_CERT=/run/secrets/smtp.crt

# Domains are normally added in the UI. An optional comma-separated list seeds the catalog on startup.
# DOMAINS=example.com,example.org
# Optional comma-separated set of addresses allowed to receive mail and be registered.
# EMAIL_ADDRESSES=hello@example.com,help@example.org

# Optional Cloudflare DNS & Email Routing API token only. Not required for login, SMTP, routing, or DNS checks.
# CLOUDFLARE_TOKEN=zone-scoped-token
# Optional HMAC secret to accept raw MIME relays on POST /api/inbound.
# INBOUND_WEBHOOK_SECRET=replace-with-random-secret
# Optional comma-separated HTTPS origins allowed for outbound mail webhooks (Zapier, Make, Pipedream, and n8n are built-in).
# WEBHOOK_ALLOWED_ORIGINS=https://hooks.example.com
# Optional Web Push: generate a stable JSON key pair with bun run push:keys https://mail.example.com
# WEB_PUSH_VAPID=
# Enable direct sends only for MCP clients that you trust.
MCP_ALLOW_SEND=false
